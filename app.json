{
  "expo": {
    "name": "MedLingua",
    "slug": "medlingua",
    "scheme": "medlingua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medlingua.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MedLingua needs the microphone to translate your medical consultation in real time.",
        "NSSpeechRecognitionUsageDescription": "MedLingua uses speech recognition to transcribe the consultation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.medlingua.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Lingua to access the microphone for speech recognition."
        }
      ],
      "@twilio/voice-react-native-sdk"
    ]
  }
}
